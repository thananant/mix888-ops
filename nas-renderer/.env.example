# ---- Mix888 NAS bill renderer ----
# คัดลอกไฟล์นี้เป็นชื่อ .env แล้วกรอกค่าให้ครบก่อนสตาร์ทคอนเทนเนอร์

# URL โปรเจกต์ Supabase
SUPABASE_URL=https://eqbzpgynzgdwvouuzfwt.supabase.co

# service_role key: Supabase Dashboard -> Settings -> API -> service_role
# คีย์นี้ข้ามสิทธิ์ RLS ทั้งหมด — เก็บไว้บน NAS เท่านั้น ห้ามใส่ในหน้าเว็บ ห้ามส่งต่อให้ใคร
SERVICE_KEY=

# รอบเช็คบิลที่รอวาด (มิลลิวินาที) — ค่าเริ่มต้น 30000 = ทุก 30 วินาที
POLL_MS=30000
